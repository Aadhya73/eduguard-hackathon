# EduGuard Backend Environment Variables (Vercel & Local)
# Production: Add these in Vercel Dashboard -> Settings -> Environment Variables

# Supabase Server-Side Configuration (Keep secret, never expose in frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Machine Learning Models Directory (Relative to backend directory)
MODEL_DIR=models/saved_models
DEFAULT_MODEL=random_forest

# Server Port (Defaults to 5000 locally, dynamically assigned on Vercel)
PORT=5000

# Allowed Frontend Origin for CORS (e.g., https://your-frontend.vercel.app or http://localhost:3000)
FRONTEND_URL=http://localhost:3000
